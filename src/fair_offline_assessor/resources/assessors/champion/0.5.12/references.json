{
  "identifier_patterns": [
    {
      "type": "inchi",
      "ruby": "/^\\w{14}-\\w{10}-\\w$/"
    },
    {
      "type": "doi",
      "ruby": "%r{^10.\\d{4,9}/[-._;()/:A-Z0-9]+$}i"
    },
    {
      "type": "handle1",
      "ruby": "%r{^[^/]+/[^/]+$}i"
    },
    {
      "type": "handle2",
      "ruby": "%r{^\\d{4,5}/[-._;()/:A-Z0-9]+$}i"
    },
    {
      "type": "uri",
      "ruby": "%r{^\\w+:/?/?[^\\s]+$}"
    },
    {
      "type": "purl",
      "ruby": "/purl\\./"
    },
    {
      "type": "ark_url",
      "ruby": "%r{\n                                                        https?://                   # http:// or https://\n                                                        [^\\s/]+?                    # domain name (non-greedy)\n                                                        /ark:                       # /ark:\n                                                        (?:/)?                      # optional extra slash (ark:/...)\n                                                        [0-9]+                      # NAAN (Name Assigning Authority Number)\n                                                        /                           # separator\n                                                        [a-z0-9~=+*@_$.\\-/]+        # Name + optional Qualifier\n                                                      }ix"
    },
    {
      "type": "ark",
      "ruby": "%r{\n                                                        \\b                          # word boundary (avoids matching inside words)\n                                                        ark:                        # literal \"ark:\"\n                                                        (?:/)?                      # optional slash\n                                                        [0-9]+                      # NAAN\n                                                        /                           # separator\n                                                        [a-z0-9~=+*@_$.\\-/]+        # Name + optional Qualifier\n                                                      }ix"
    }
  ],
  "self_identifier_predicates": [
    "http://purl.org/dc/elements/1.1/identifier",
    "https://purl.org/dc/elements/1.1/identifier",
    "http://purl.org/dc/terms/identifier",
    "http://schema.org/identifier",
    "https://purl.org/dc/terms/identifier",
    "https://schema.org/identifier"
  ],
  "data_predicates": [
    "http://www.w3.org/ns/ldp#contains",
    "http://xmlns.com/foaf/0.1/primaryTopic",
    "http://purl.obolibrary.org/obo/IAO_0000136",
    "http://purl.obolibrary.org/obo/IAO:0000136",
    "https://www.w3.org/ns/ldp#contains",
    "https://xmlns.com/foaf/0.1/primaryTopic",
    "http://schema.org/mainEntity",
    "http://schema.org/codeRepository",
    "http://schema.org/distribution",
    "http://schema.org/contentUrl",
    "https://schema.org/mainEntity",
    "https://schema.org/codeRepository",
    "https://schema.org/distribution",
    "https://schema.org/contentUrl",
    "http://www.w3.org/ns/dcat#distribution",
    "https://www.w3.org/ns/dcat#distribution",
    "http://www.w3.org/ns/dcat#dataset",
    "https://www.w3.org/ns/dcat#dataset",
    "http://www.w3.org/ns/dcat#downloadURL",
    "https://www.w3.org/ns/dcat#downloadURL",
    "http://www.w3.org/ns/dcat#accessURL",
    "https://www.w3.org/ns/dcat#accessURL",
    "http://semanticscience.org/resource/SIO_000332",
    "http://semanticscience.org/resource/is-about",
    "https://semanticscience.org/resource/SIO_000332",
    "https://semanticscience.org/resource/is-about",
    "https://purl.obolibrary.org/obo/IAO_0000136"
  ],
  "persistent_url_patterns": [
    "/(purl)\\./",
    "/(oclc)\\./",
    "/(fdlp)\\./",
    "/(purlz)\\./",
    "/(w3id)\\./",
    "/(ark):/",
    "/(doi.org)/"
  ],
  "accepted_vocabulary_patterns": [
    "%r{purl.org/dc/}",
    "%r{/vcard/}",
    "%r{w3\\.org/ns/dcat}",
    "%r{xmlns\\.com/foaf/}"
  ],
  "vocabulary_threshold": 0.66,
  "license_predicates": {
    "weak": [
      "http://www.w3.org/1999/xhtml/vocab#license",
      "https://www.w3.org/1999/xhtml/vocab#license",
      "http://purl.org/ontology/dvia#hasLicense",
      "https://purl.org/ontology/dvia#hasLicense",
      "http://purl.org/dc/terms/license",
      "https://purl.org/dc/terms/license",
      "http://creativecommons.org/ns#license",
      "https://creativecommons.org/ns#license",
      "http://reference.data.gov.au/def/ont/dataset#hasLicense",
      "https://reference.data.gov.au/def/ont/dataset#hasLicense",
      "https://schema.org/license",
      "http://schema.org/license"
    ],
    "strong": [
      "http://www.w3.org/1999/xhtml/vocab#license",
      "https://www.w3.org/1999/xhtml/vocab#license",
      "http://purl.org/ontology/dvia#hasLicense",
      "https://purl.org/ontology/dvia#hasLicense",
      "http://purl.org/dc/terms/license",
      "https://purl.org/dc/terms/license",
      "http://creativecommons.org/ns#license",
      "https://creativecommons.org/ns#license",
      "http://reference.data.gov.au/def/ont/dataset#hasLicense",
      "https://reference.data.gov.au/def/ont/dataset#hasLicense",
      "https://schema.org/license",
      "http://schema.org/license"
    ]
  },
  "persistence_policy_predicate": "http://www.w3.org/2000/10/swap/pim/doc#persistencePolicy",
  "outward_link_exclusion": "%r{1999/xhtml}"
}
