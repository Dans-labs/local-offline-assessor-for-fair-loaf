    }
  },
  "cases": [
    {
      "case_id": "ordinary-url",
      "request": {
        "target_identifier": "https://example.org/record",
        "metadata": {
          "http://purl.org/dc/terms/identifier": {
            "@id": "https://example.org/record"
          },
          "http://schema.org/contentUrl": {
            "@id": "https://example.org/file"
          }
        }
      },
      "expected": {
        "test_FM_A1_1_M_OpenProt": [
          "pass",
          "passed"
        ],
        "test_FM_A1_2_M_Auth": [
          "pass",
          "passed"
        ],
        "test_FM_F1_M_IdentPersistent": [
          "indeterminate",
          "upstream_indeterminate"
        ],
        "test_FM_F3_M_MetaIdent": [
          "pass",
          "passed"
        ],
        "test_FM_A1_1_M_OpenProt_Data": [
          "pass",
          "passed"
        ]
      },
      "rationale": "An ordinary URL passes classification and exact self-reference but has no known persistence pattern. The data URI is classified without retrieval."
    },
    {
      "case_id": "invalid-metadata",
      "request": {
        "metadata": null,
        "target_identifier": "https://example.org/item"
      },
      "expected": {
        "test_FM_F1_M_IdentUnique": [
          "pass",
          "passed"
        ],
        "test_FM_F3_M_DataIdent": [
          "indeterminate",
          "unsupported_input"
        ]
      },
      "rationale": "Invalid metadata blocks graph-dependent checks with its diagnostic, while the independent target check still passes."
    },
    {
      "case_id": "unknown-target",
      "request": {
        "target_identifier": "unknown",
        "metadata": {
          "http://purl.org/dc/terms/identifier": "unknown"
        }
      },
      "expected": {
        "test_FM_F1_M_IdentUnique": [
          "indeterminate",
          "upstream_indeterminate"
        ],
        "test_FM_F3_M_MetaIdent": [
          "indeterminate",
          "upstream_indeterminate"
        ]
      },
      "rationale": "Unrecognized targets remain indeterminate, including when the metadata repeats the same value."
    },
    {
      "case_id": "bare-doi",
      "request": {
        "metadata": {
          "http://purl.org/dc/terms/identifier": "https://doi.org/10.1234/abc"
        },
        "target_identifier": "10.1234/abc"
      },
      "expected": {
        "test_FM_F1_M_IdentPersistent": [
          "pass",
          "passed"
        ],
        "test_FM_F3_M_MetaIdent": [
          "pass",
          "passed"
        ]
      },
      "rationale": "A bare DOI passes persistence directly and matches its resolver form in metadata."
    },
    {
      "case_id": "doi-resolver",
      "request": {
        "metadata": {
          "http://purl.org/dc/terms/identifier": "10.1234/abc"
        },
        "target_identifier": "https://dx.doi.org/10.1234/abc"
      },
      "expected": {
        "test_FM_F1_M_IdentPersistent": [
          "pass",
          "passed"
        ],
        "test_FM_F3_M_MetaIdent": [
          "pass",
          "passed"
        ]
      },
      "rationale": "A resolver URL passes the persistent-URL pattern and matches its extracted bare DOI. The dx.doi.org resolver is accepted upstream."
    },
    {
      "case_id": "empty-first-self-id",
      "request": {
        "metadata": {
          "http://purl.org/dc/terms/identifier": [
            "",
            "10.1234/abc"
          ]
        },
        "target_identifier": "10.1234/abc"
      },
      "expected": {
        "test_FM_F3_M_MetaIdent": [
          "fail",
          "failed"
        ]
      },
      "rationale": "The first identifier must contain a word character even if a later one matches."
    },
    {
      "case_id": "self-id-mismatch",
      "request": {
        "metadata": {
          "http://purl.org/dc/terms/identifier": "10.1234/ABC"
        },
        "target_identifier": "10.1234/abc"
      },
      "expected": {
        "test_FM_F3_M_MetaIdent": [
          "fail",
          "failed"
        ]
      },
      "rationale": "DOI forms are compared exactly; suffix case is not normalized."
    },
    {
      "case_id": "empty-graph",
      "request": {
        "metadata": {},
        "target_identifier": "10.1234/abc"
      },
      "expected": {
        "test_FM_F3_M_MetaIdent": [
          "indeterminate",
          "upstream_indeterminate"
        ],
        "test_FM_F3_M_DataIdent": [
          "fail",
          "failed"
        ],
        "test_FM_A1_2_M_DataAuth": [
          "indeterminate",
          "upstream_indeterminate"
        ]
      },
      "rationale": "A valid empty graph gives different upstream decisions: metadata self-reference and data authentication are indeterminate, while the missing data identifier fails F3."
    },
    {
      "case_id": "missing-self-id",
      "request": {
        "metadata": {
          "urn:title": "Title"
        },
        "target_identifier": "10.1234/abc"
      },
      "expected": {
        "test_FM_F3_M_MetaIdent": [
          "fail",
          "failed"
        ]
      },
      "rationale": "Nonempty graph without a recognized self-identifier fails."
    },
    {
      "case_id": "unrecognized-data-id",
      "request": {
        "metadata": {
          "http://schema.org/contentUrl": "unrecognized"
        }
      },
      "expected": {
        "test_FM_F3_M_DataIdent": [
          "pass",
          "passed"
        ],
        "test_FM_A1_1_M_OpenProt_Data": [
          "indeterminate",
          "upstream_indeterminate"
        ]
      },
      "rationale": "Without a target, a word-like data value passes F3 existence but remains unrecognized by protocol classification."
    },
    {
      "case_id": "missing-target",
      "request": {
        "metadata": {
          "http://purl.org/dc/terms/identifier": "10.1234/abc"
        }
      },
      "expected": {
        "test_FM_F3_M_MetaIdent": [
          "indeterminate",
          "missing_evidence"
        ]
      },
      "rationale": "Offline guard: target cannot be inferred from the metadata being assessed."
    },
    {
      "case_id": "invalid-target",
      "request": {
        "metadata": {},
        "target_identifier": 42
      },
      "expected": {
        "test_FM_F1_M_IdentUnique": [
          "indeterminate",
          "invalid_target_identifier"
        ]
      },
      "rationale": "Offline guard: retain the specific validation diagnostic."
    },
    {
      "case_id": "punctuation-data-id",
      "request": {
        "metadata": {
          "http://schema.org/contentUrl": "!!!/!!!"
        }
      },
      "expected": {
        "test_FM_A1_1_M_OpenProt_Data": [
          "indeterminate",
          "upstream_indeterminate"
        ],
        "test_FM_A1_2_M_DataAuth": [
          "pass",
          "passed"
        ]
      },
      "rationale": "Regression: OpenProt_Data requires an ASCII word character; DataAuth classifies directly and accepts the broad handle pattern."
    }
  ]
}
