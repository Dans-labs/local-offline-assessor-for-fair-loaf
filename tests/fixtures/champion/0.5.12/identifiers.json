      "lib/harvester.rb": "96d3dc2bfb69c9f28839c229101867dc71b2391b87b4939c8cd23e1fa7882ee2"
    },
    "method": "Expected outcomes reviewed against pinned Ruby source; Ruby was not executed."
  },
  "sources": {
